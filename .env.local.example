NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 站点对外地址（OAuth 回调用，生产示例：https://workbench.attaboy0328.workers.dev）
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Google Drive OAuth（https://console.cloud.google.com/ 创建 OAuth 客户端）
# 授权重定向 URI 填：{NEXT_PUBLIC_APP_URL}/api/cloud/google/callback
# 启用 Google Drive API + 授权范围 drive.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
